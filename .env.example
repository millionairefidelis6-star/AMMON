# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Email Delivery Configuration for AMMON Member Registration OTPs:
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"
# EMAIL_FROM="AMMON Nigeria <onboarding@resend.dev>"

# Dedicated AMMON Firebase Application & Isolated Storage Bucket Overrides
# (Create a separate Firebase Project or separate Web App + Storage Bucket in Firebase Console)
# VITE_AMMON_FIREBASE_PROJECT_ID="ammon-nigeria-prod"
# VITE_AMMON_FIREBASE_APP_ID="1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx"
# VITE_AMMON_FIREBASE_API_KEY="AIzaSy..."
# VITE_AMMON_FIREBASE_AUTH_DOMAIN="ammon-nigeria-prod.firebaseapp.com"
# VITE_AMMON_FIREBASE_MESSAGING_SENDER_ID="000000000000"
# VITE_AMMON_FIRESTORE_DATABASE_ID="ai-studio-ammonassociation-006a15f5-aafc-45d8-9b0e-10f15ce87f61"
# VITE_AMMON_STORAGE_BUCKET="ammon-nigeria-media.firebasestorage.app"
