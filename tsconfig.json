{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "types": ["node", "vite/client"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "noEmit": true
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "server.js", "server/**/*.js", "vite.config.js"],
  "exclude": ["dist", "node_modules"]
}
